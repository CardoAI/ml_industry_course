name: adult-income-mlops

# Uses the day4 project environment managed by uv.
# Run `cd day4 && uv sync` before using mlflow run.

entry_points:

  # ── Main: train and log a model run ────────────────────────────────────────
  main:
    parameters:
      n_estimators:     {type: int,   default: 300}
      learning_rate:    {type: float, default: 0.1}
      max_depth:        {type: int,   default: 5}
      num_leaves:       {type: int,   default: 31}
      mlflow_uri:       {type: str,   default: "http://127.0.0.1:5000"}
      experiment_name:  {type: str,   default: "adult-income-lgbm"}
      run_name:         {type: str,   default: "mlproject-run"}
      data_path:        {type: str,   default: "day1/generated/adult_income_issues.csv"}
      register:         {type: str,   default: "false"}
      model_name:       {type: str,   default: "adult-income-classifier"}
    command: >-
      python day4/src/train.py
        --n-estimators {n_estimators}
        --learning-rate {learning_rate}
        --max-depth {max_depth}
        --num-leaves {num_leaves}
        --mlflow-uri {mlflow_uri}
        --experiment-name {experiment_name}
        --run-name {run_name}
        --data-path {data_path}
        --register {register}
        --model-name {model_name}

  # ── Drift check: run NannyML monitoring ────────────────────────────────────
  drift-check:
    parameters:
      data_path:       {type: str,   default: "day1/generated/adult_income_issues.csv"}
      model_uri:       {type: str,   default: "models:/adult-income-classifier/Production"}
      mlflow_uri:      {type: str,   default: "http://127.0.0.1:5000"}
      auc_threshold:   {type: float, default: 0.80}
      max_drifted:     {type: int,   default: 5}
      output_dir:      {type: str,   default: "day4/outputs"}
    command: >-
      python day4/src/nannyml_check.py
        --data-path {data_path}
        --model-uri {model_uri}
        --mlflow-uri {mlflow_uri}
        --auc-threshold {auc_threshold}
        --max-drifted-features {max_drifted}
        --output-dir {output_dir}
        --fail-on-drift
